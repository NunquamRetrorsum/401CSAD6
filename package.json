{
  "name": "hello-world-ts",
  "version": "1.0.0",
  "description": "Кросплатформний Hello World на TypeScript, згенерований AI-агентом build-engineer (АПКС, лабораторна робота 1, варіант 6)",
  "private": true,
  "type": "module",
  "main": "dist/hello.js",
  "bin": {
    "hello": "dist/hello.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/hello.js",
    "clean": "node scripts/clean.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
